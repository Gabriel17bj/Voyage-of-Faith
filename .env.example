# GEMINI_API_KEY: Google AI Studio에서 사용하는 구글 API 키 (그대로 유지)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────────
# Firebase (구글) — 수업 코드 / 교사 대시보드 실시간 모니터링 / 게임 기록 영구 저장
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 의 firebaseConfig 값을 그대로 넣으세요.
# API 키는 구글 API 키(AIza...)를 그대로 사용합니다.
# Vercel: Project Settings > Environment Variables 에 같은 이름으로 등록
# (최소 필수: VITE_FIREBASE_API_KEY, VITE_FIREBASE_PROJECT_ID)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
# 선택: 기본이 아닌 Firestore 데이터베이스를 쓸 때만 (예: AI Studio가 만든 DB ID)
VITE_FIREBASE_DATABASE_ID=""
